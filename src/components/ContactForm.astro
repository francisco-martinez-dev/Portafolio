---
const rawEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim() || '';
const configured = /^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(rawEndpoint) && !rawEndpoint.includes('tu-id');
---

<form id="contact-form" action={configured ? rawEndpoint : undefined} method="POST" class="grid gap-5" aria-describedby="contact-help" data-configured={String(configured)}>
  <p id="contact-help" class="text-sm text-steel dark:text-line-light">Todos los campos son obligatorios.</p>
  <div class="hidden" aria-hidden="true"><label for="contact-website">Dejar vacío</label><input id="contact-website" type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
  <div>
    <label for="contact-name" class="text-sm text-steel dark:text-line-light">Nombre</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" class="mt-1.5 w-full rounded-lg border border-line-light bg-transparent px-4 py-2.5 text-sm focus-visible:border-accent dark:border-line-dark" />
  </div>
  <div>
    <label for="contact-email" class="text-sm text-steel dark:text-line-light">Correo electrónico</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" class="mt-1.5 w-full rounded-lg border border-line-light bg-transparent px-4 py-2.5 text-sm focus-visible:border-accent dark:border-line-dark" />
  </div>
  <div>
    <label for="contact-message" class="text-sm text-steel dark:text-line-light">Mensaje</label>
    <textarea id="contact-message" name="message" rows="5" required minlength="10" maxlength="5000" aria-describedby="message-help" class="mt-1.5 w-full resize-y rounded-lg border border-line-light bg-transparent px-4 py-2.5 text-sm focus-visible:border-accent dark:border-line-dark"></textarea>
    <p id="message-help" class="mt-1 text-xs text-steel dark:text-line-light">Escribí al menos 10 caracteres.</p>
  </div>
  <button id="contact-submit" type="submit" disabled={!configured} class="mt-2 w-fit rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform duration-200 hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-accent dark:text-ink">Enviar mensaje</button>
  <p id="contact-status" role="status" aria-live="polite" aria-atomic="true" class="text-sm text-steel dark:text-line-light">
    {!configured && <>El formulario todavía no está configurado. Mientras tanto, podés utilizar el enlace de correo electrónico que aparece a la derecha o debajo.</>}
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const submit = document.querySelector<HTMLButtonElement>('#contact-submit');
  form?.addEventListener('submit', async (event) => {
    if (form.dataset.configured !== 'true' || !form.action) { event.preventDefault(); return; }
    if (!form.reportValidity()) return;
    event.preventDefault();
    if (!submit || !status) return;
    submit.disabled = true;
    submit.textContent = 'Enviando…';
    status.textContent = 'Enviando tu mensaje…';
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Error al enviar');
      form.reset();
      status.textContent = 'Mensaje enviado correctamente. ¡Gracias por escribirme!';
    } catch {
      status.textContent = 'No se pudo enviar el mensaje. Intentá de nuevo o escribime directamente por correo electrónico.';
    } finally {
      submit.disabled = false;
      submit.textContent = 'Enviar mensaje';
    }
  });
</script>
