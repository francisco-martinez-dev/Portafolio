---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import WeatherDashboardEmbed from '../components/react/WeatherDashboardEmbed.jsx';
import projects from '../data/projects.json';

const experience = [
  {
    period: 'Junio 2026 – Actualidad',
    role: 'Ingeniero de Calidad (QA Intern)',
    org: 'Almacenes Siman',
    description:
      'Análisis de requerimientos e historias de usuario; diseño, ejecución y documentación de pruebas funcionales manuales en Jira y Xray. Validación de procesos internos y colaboración con desarrolladores.',
    tags: ['QA manual', 'Pruebas funcionales', 'Jira', 'Xray'],
    current: true,
  },
  {
    period: 'Junio 2022 – Noviembre 2022',
    role: 'Desarrollador Frontend Junior (Pasantía)',
    org: 'Banco Cuscatlán',
    description:
      'Participación en el desarrollo del sitio web del banco con Angular y TypeScript: interfaces y componentes interactivos para contenido institucional y productos bancarios, e integración de una API REST de divisas.',
    tags: ['Angular', 'TypeScript', 'REST APIs'],
    isLast: true,
  },
];

const skillGroups = [
  {
    category: 'Frontend',
    skills: [
      'Angular',
      'React.js',
      'TypeScript',
      'JavaScript',
      'HTML5',
      'CSS3',
      'Tailwind CSS',
      'Bootstrap',
    ],
  },
  {
    category: 'QA',
    skills: ['Jira', 'Xray', 'Testing funcional', 'Diseño de casos de prueba'],
  },
  {
    category: 'Herramientas',
    skills: ['Git', 'GitHub', 'REST APIs', 'Python', 'Scrum', 'Kanban'],
  },
  {
    category: 'Inglés',
    skills: ['Documentación técnica', 'Comunicación escrita y conversacional'],
  },
];
---

<BaseLayout
  title="Francisco Martínez — Desarrollo de Software | Frontend & QA"
  description="Portafolio de Francisco Martínez: experiencia en desarrollo frontend con Angular y TypeScript para el sector bancario, y QA manual y funcional con Jira y Xray."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Francisco Martínez',
    url: 'https://francisco-martinez-dev.vercel.app/',
    jobTitle: 'Desarrollo de Software | Frontend & QA',
    sameAs: [
      'https://github.com/francisco-martinez-dev',
      'https://www.linkedin.com/in/francisco-alejandro-martinez-linares/'
    ]
  })} />
  <Header />
  <main id="contenido-principal" tabindex="-1">
    <Hero />

    <section id="proyectos" class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Proyectos
      </h2>
      <p class="mt-3 max-w-xl text-steel dark:text-line-light">
        Cuatro proyectos, cuatro decisiones técnicas distintas. El primero corre en vivo, aquí mismo.
      </p>

      <div class="mt-4">
        {projects.map((project, i) =>
          project.featured ? (
            <ProjectCard
              name={project.name}
              problem={project.problem}
              decision={project.decision}
              result={project.result}
              stack={project.stack}
              demoUrl={project.demoUrl}
              repoUrl={project.repoUrl}
              image={project.image}
              index={i + 1}
            >
              <WeatherDashboardEmbed client:visible />
            </ProjectCard>
          ) : (
            <ProjectCard
              name={project.name}
              problem={project.problem}
              decision={project.decision}
              result={project.result}
              stack={project.stack}
              demoUrl={project.demoUrl}
              repoUrl={project.repoUrl}
              image={project.image}
              index={i + 1}
            />
          )
        )}
      </div>
    </section>

    <section id="experiencia" class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Sobre mí
      </h2>
      <p class="reveal mt-3 max-w-xl text-steel dark:text-line-light">
        Soy estudiante de Ingeniería en Desarrollo de Software y Ciencia de Datos.
        Participé en el desarrollo de interfaces web para Banco Cuscatlán con
        Angular y TypeScript. Actualmente trabajo en QA manual y funcional en
        Almacenes Siman, analizando requerimientos, diseñando y ejecutando
        pruebas y documentando resultados. Busco oportunidades junior en
        desarrollo frontend o calidad de software.
      </p>

      <div class="mt-10">
        {experience.map((item) => <ExperienceItem {...item} />)}
      </div>
    </section>

    <section id="skills" class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Skills
      </h2>
      <p class="reveal mt-3 max-w-xl text-steel dark:text-line-light">
        Tecnologías y herramientas que utilizo en desarrollo frontend y pruebas funcionales.
      </p>

      <div class="mt-10 grid gap-10 sm:grid-cols-2">
        {skillGroups.map((group) => (
          <div class="reveal">
            <h3 class="font-display text-sm uppercase tracking-[0.15em] text-accent">
              {group.category}
            </h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((skill) => <SkillBadge label={skill} />)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="contacto" class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Contacto
      </h2>
      <p class="reveal mt-3 max-w-xl text-steel dark:text-line-light">
        ¿Tenés una oportunidad junior en desarrollo frontend o QA? Conversemos.
      </p>

      <div class="reveal mt-10 grid min-w-0 gap-10 md:grid-cols-2">
        <ContactForm />

        <div class="min-w-0 flex flex-col justify-center break-words text-sm text-steel dark:text-line-light">
          <p>
            También podés escribirme directo a
            <a href="mailto:franciscolinares000@gmail.com" class="text-ink underline underline-offset-2 hover:text-accent dark:text-paper">franciscolinares000@gmail.com</a>
            o conectar en
            <a href="https://www.linkedin.com/in/francisco-alejandro-martinez-linares/" target="_blank" rel="noreferrer" class="text-ink underline underline-offset-2 hover:text-accent dark:text-paper">LinkedIn</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>